{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/plataforma",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/plataforma/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/julianramos",
      "destination": "/artistas/la-libreta/index.html"
    },
    {
      "source": "/julianramos/",
      "destination": "/artistas/la-libreta/index.html"
    },
    {
      "source": "/helementt",
      "destination": "/artistas/helementt/index.html"
    },
    {
      "source": "/helementt/",
      "destination": "/artistas/helementt/index.html"
    }
  ]
}
