{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "P=$VERCEL_GIT_PREVIOUS_SHA; if [ -n \"$P\" ] && git cat-file -e \"$P^{commit}\" 2>/dev/null && git diff --quiet \"$P\" HEAD -- . ':!tienda' ':!admin' ':!lujourban-vision' ':!supabase' ':!.github' ':!*.md'; then exit 0; else exit 1; fi",
  "redirects": [
    {
      "source": "/plataforma",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/plataforma/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/julianramos",
      "destination": "/artistas/la-libreta/index.html"
    },
    {
      "source": "/julianramos/",
      "destination": "/artistas/la-libreta/index.html"
    },
    {
      "source": "/helementt",
      "destination": "/artistas/helementt/index.html"
    },
    {
      "source": "/helementt/",
      "destination": "/artistas/helementt/index.html"
    }
  ]
}
