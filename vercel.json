{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)tienda' ':(exclude)admin' ':(exclude)lujourban-vision' ':(exclude)supabase' ':(exclude).github' ':(exclude)*.md'; then exit 0; else exit 1; fi",
  "redirects": [
    {
      "source": "/plataforma",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/plataforma/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/julianramos",
      "destination": "/artistas/la-libreta/index.html"
    },
    {
      "source": "/julianramos/",
      "destination": "/artistas/la-libreta/index.html"
    },
    {
      "source": "/helementt",
      "destination": "/artistas/helementt/index.html"
    },
    {
      "source": "/helementt/",
      "destination": "/artistas/helementt/index.html"
    }
  ]
}
