NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# MercadoPago Checkout Pro (Colombia)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
# Secreto del webhook configurado en MercadoPago para validar x-signature.
# Si falta, el webhook sigue reconsultando el pago pero no aplica este primer candado.
MERCADOPAGO_WEBHOOK_SECRET=

# URL publica de esta tienda (para back_urls / metadata)
SITE_URL=https://tienda.lujourban.com

# Resend (envio de correo con los enlaces de descarga)
RESEND_API_KEY=re_xxx
